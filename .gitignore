# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Environment configuration. The example file is committed; real ones are not:
# they carry the project URL and key for an actual Supabase project.
/config/*.json
!/config/*.example.json

# Local secrets. Never commit these - third-party API keys live here during
# development. GitHub push protection caught this file once already.
.env
.env.*
!.env.example

# Supabase CLI local state. Migrations are committed; these are not.
supabase/.branches
supabase/.temp
